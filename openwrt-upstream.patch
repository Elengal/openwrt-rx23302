diff --git a/include/package.mk b/include/package.mk
index d4d67413..77459506 100644
--- a/include/package.mk
+++ b/include/package.mk
@@ -91,6 +91,16 @@ ifneq ($(wildcard $(PKG_BUILD_DIR)/.source_dir),)
   QUILT:=1
 endif
 
+# RX23302: patches for packages that come from feeds. Feeds are git checkouts pinned
+# by commit and are not edited; their packages read patches from ./patches only, which
+# would mean writing into the feed. $(TOPDIR)/feeds-patches/<PKG_NAME>/ is used instead
+# when it exists, applied by the usual Build/Patch, and it takes part in the prepare
+# stamp, so changing a patch rebuilds the package.
+ifneq ($(wildcard $(TOPDIR)/feeds-patches/$(PKG_NAME)/*.patch),)
+  PATCH_DIR:=$(TOPDIR)/feeds-patches/$(PKG_NAME)
+  PKG_FILE_DEPENDS += $(TOPDIR)/feeds-patches/$(PKG_NAME)
+endif
+
 include $(INCLUDE_DIR)/quilt.mk
 
 find_library_dependencies = \
