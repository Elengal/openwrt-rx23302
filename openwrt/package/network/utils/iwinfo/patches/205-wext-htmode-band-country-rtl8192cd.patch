+	e->mhz = (uint32_t)mhz;
+
+	if (mhz >= 5925 && mhz <= 7125)
+		e->band = IWINFO_BAND_6;
+	else if (mhz >= 5160 && mhz <= 5885)
+		e->band = IWINFO_BAND_5;
+	else if (mhz >= 58320 && mhz <= 69120)
+		e->band = IWINFO_BAND_60;
