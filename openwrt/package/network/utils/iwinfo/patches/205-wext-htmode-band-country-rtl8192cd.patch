 /*
+ * RX23302: current HT mode of an interface.
+ *
+ * The ops table had no .htmode at all (NULL), and rpcd calls it without a
+ * check in rpc_iwinfo_call_hw_ht_mode(): every "ubus call iwinfo info" -
+ * LuCI channel analysis, status pages - crashed rpcd with SIGSEGV at address 0
+ * and took all LuCI sessions with it (they live inside rpcd). 3 crashes on the
+ * board on 05.10.2026.
+ *
+ * Built from what the driver runs right now: the PHY family from
+ * /proc/<ifname>/mib_operation "net_work_type: BGN" / "ANAC" (802.11 modes
+ * enabled), the width from mib_11n "currBW(op)". A legacy radio (no N) has no
+ * HT mode: IWINFO_HTMODE_NOHT, as the nl80211 backend reports it.
+ */
+static int wext_get_htmode(const char *ifname, int *buf)
+{
+	char modes[16];
+	int mhz, vht, ht;
+
+	*buf = 0;
+
+	if (wext_rtl_proc_value(ifname, "mib_operation", "net_work_type",
+	                        modes, sizeof(modes)))
+		return -1;
+
+	vht = (strstr(modes, "AC") != NULL);
+	ht  = vht || (strchr(modes, 'N') != NULL);
+
+	if (!ht)
+	{
+		*buf = IWINFO_HTMODE_NOHT;
+		return 0;
+	}
+
+	if ((mhz = wext_rtl_bw_mhz(ifname)) < 0)
+		return -1;
+
+	switch (mhz)
+	{
+	case 20:
+		*buf = vht ? IWINFO_HTMODE_VHT20 : IWINFO_HTMODE_HT20;
+		break;
+
+	case 40:
+		*buf = vht ? IWINFO_HTMODE_VHT40 : IWINFO_HTMODE_HT40;
+		break;
+
+	case 80:
+		*buf = IWINFO_HTMODE_VHT80;
+		break;
+
+	case 160:
+		*buf = IWINFO_HTMODE_VHT160;
+		break;
