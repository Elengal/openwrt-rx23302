 static int wext_get_country(const char *ifname, char *buf)
 {
+	char cc[8];
+
+	/* RX23302: the regulatory country the driver really runs with, MIB
+	   "countrystr" (dot11CountryString, set from UCI option country by
+	   /lib/netifd/wireless/rtl8192cd.sh). LuCI showed "00" here although
+	   the radio worked under RU rules. */
+	if (wext_rtl_is_rtl(ifname) &&
+	    !wext_rtl_get_mib(ifname, "countrystr", cc, sizeof(cc)) &&
+	    isalpha((unsigned char)cc[0]) && isalpha((unsigned char)cc[1]))
+	{
+		buf[0] = (char)toupper((unsigned char)cc[0]);
+		buf[1] = (char)toupper((unsigned char)cc[1]);
+		buf[2] = 0;
+		return 0;
+	}
+
 	sprintf(buf, "00");
 	return 0;
 }
 
