-static uint32_t wext_sta_last_number(const char *s)
+/*
+ * RX23302: the rate is the LAST token of the line and may be fractional. The
+ * driver prints HT rates from MCS_DATA_RATEStr (8192cd_proc.c): "MCS0 6.5",
+ * "MCS7 72.2" (short GI), "MCS15 144.4". The former wext_sta_last_number()
+ * took only all-digit tokens, so every fractional rate came out as 0 kbit/s.
+ * Returns kbit/s, 0 if the line has no rate.
+ */
+static uint32_t wext_sta_last_rate_kbps(const char *s)
 {
-	const char *p = s;
-	uint32_t rv = 0;
+	const char *p = s, *tok = NULL, *start;
+	uint32_t whole = 0, frac = 0, scale = 1000;
 
-	/* Take the final all-digit token: "VHT NSS2-MCS5  468" gives 468,
-	   "6" gives 6, while "HT MCS7" has no such token and leaves the
-	   rate unknown (0). */
 	while (*p)
 	{
-		const char *start;
-
 		while (*p && isspace((unsigned char)*p))
 			p++;
 
@@ -476,42 +714,68 @@
 		if (p > start)
 		{
 			const char *q;
-			int digits = 1;
+			int ok = isdigit((unsigned char)*start), dots = 0;
 
-			for (q = start; q < p; q++)
+			for (q = start; ok && q < p; q++)
 			{
-				if (!isdigit((unsigned char)*q))
-				{
-					digits = 0;
-					break;
-				}
+				if (*q == '.')
+					ok = (++dots == 1);
+				else if (!isdigit((unsigned char)*q))
+					ok = 0;
 			}
 
-			if (digits)
-				rv = (uint32_t)strtoul(start, NULL, 10);
+			if (ok)
+				tok = start;
 		}
 	}
 
-	return rv;
+	if (!tok)
+		return 0;
+
+	while (isdigit((unsigned char)*tok))
+		whole = whole * 10 + (uint32_t)(*tok++ - '0');
+
+	if (*tok == '.')
+	{
+		tok++;
+
+		while (isdigit((unsigned char)*tok) && scale > 1)
+		{
+			scale /= 10;
+			frac += (uint32_t)(*tok++ - '0') * scale;
+		}
+	}
+
+	return whole * 1000 + frac;
 }
 
 static void wext_sta_parse_rate(const char *val, struct iwinfo_rate_entry *r)
 {
 	const char *p;
 
+	/* "VHT NSS2-MCS9s  867", "MCS15 130" (HT: no "HT" in the text), "54" */
 	if (strstr(val, "VHT"))
 		r->is_vht = 1;
-	else if (strstr(val, "HT"))
+	else if (strstr(val, "MCS"))
 		r->is_ht = 1;
 
 	if ((p = strstr(val, "MCS")) != NULL)
+	{
 		r->mcs = (int8_t)atoi(p + 3);
 
+		/* VHT: "MCS9s" = short guard interval (8192cd_proc.c) */
+		for (p += 3; isdigit((unsigned char)*p); p++)
+			;
+
+		if (*p == 's')
+			r->is_short_gi = 1;
+	}
+
 	if ((p = strstr(val, "NSS")) != NULL)
 		r->nss = (uint8_t)atoi(p + 3);
 
 	/* iwinfo stores the speed in kbit/s, the driver prints Mbit/s */
-	r->rate = wext_sta_last_number(val) * 1000;
+	r->rate = wext_sta_last_rate_kbps(val);
 }
 
 static void wext_sta_parse_bw(const char *val, struct iwinfo_rate_entry *r)
@@ -521,10 +785,11 @@
 	if (mhz <= 0)
 		return;
 
-	r->mhz = (uint8_t)mhz;
-
-	if (mhz == 40)
-		r->is_40mhz = 1;
+	/* RX23302: the field is 16 bit wide (mhz_hi:mhz, rpcd prints
+	   mhz_hi * 256 + mhz); "160M" did not fit into the low byte alone. */
+	r->mhz = (uint8_t)(mhz & 0xff);
+	r->mhz_hi = (uint8_t)(mhz >> 8);
+	r->is_40mhz = (mhz == 40);
 }
 
