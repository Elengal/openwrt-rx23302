From: openwrt-rx23302
Date: Tue, 6 Oct 2026 08:30:00 +0300
Subject: [PATCH] wext: htmode, survey, band, country, signal and chip name for rtl8192cd

Found on the board (ELECTRA RX23302, rtl8192fe 3.8.0, OpenWrt snapshot, LuCI master)
on 05.10.2026, with a browser walk through LuCI:

- .htmode was NULL in wext_ops. rpcd calls it unchecked (rpc_iwinfo_call_hw_ht_mode),
  so every "ubus call iwinfo info" (LuCI channel analysis) crashed rpcd with SIGSEGV at
  address 0, dropping all LuCI sessions. Now read from the driver: net_work_type
  (mib_operation) + currBW(op) (mib_11n). .survey added for the same reason ("no data").
- wext_get_freqlist() left band and flags uninitialised: 5180 MHz was reported as a
  2.4 GHz channel with random flags, and LuCI offered no 5 GHz channel. memset + band
  by frequency, like nl80211_freq2band().
- country: "00" stub -> MIB "countrystr" of the driver (get_mib ioctl); countrylist =
  the 100 countries of the driver's own table (8192cd_11h.c), so LuCI offers them (v4).
- signal/quality of an access point: average RSSI of its stations (sta_info), on the
  nl80211 scale (quality 0..70), instead of nothing.
- hardware name: "Realtek RTL8197G" / "Realtek RTL8812F" (mib_rf chipVersion); hardware_id
  succeeds (IDs 0, no bus) so that rpcd-mod-luci passes the name on to LuCI.
- scan: iwinfo_wext_scan.c had its own wext_ioctl() without the UCI radio name
  resolution of patch 204, so LuCI's "Scan" (by "radio0") always found nothing
  while "wlan0" found 8 networks. wext_uci_ifname() is now shared.
- scan results: the driver reports a quality (RSSI %) with the level marked invalid,
  rpcd printed "-256 dBm" for every network -> level derived from the RSSI; the
  encryption comes as an IWEVCUSTOM text ("OPEN"/"WPA2-PSK"), not SIOCGIWENCODE,
  so every network showed "None"; band/frequency filled from the channel (LuCI's
  channel analysis drops cells without a band).
- assoclist: transmit width from current_tx_BW (rate adaptation) instead of tx_bw
  (station capability; a 40 MHz capable phone showed 40 MHz on an HT20 network),
  VHT receive rate key "rx_rate", fractional HT rates ("6.5", "72.2"), VHT short GI.

All new paths are taken only for this driver: /proc/<ifname>/sta_info and mib_* exist
only for rtl8192cd interfaces.

--- a/iwinfo_wext.c
+++ b/iwinfo_wext.c
@@ -59,7 +59,7 @@
  * Scoped to this driver on purpose: iwinfo_uci_get_radio() only returns a section whose
  * type option is rtl8192cd, so nothing else changes behaviour.
  */
-static const char * wext_uci_ifname(const char *name)
+const char * wext_uci_ifname(const char *name)
 {
 	static char ifname[IFNAMSIZ];
 	struct uci_section *s;
@@ -110,6 +110,213 @@
 	return 0;
 }
 
+/*
+ * RX23302: netdev behind a name, for reading the driver's /proc/<ifname>/ files.
+ *
+ * LuCI and rpcd ask by UCI section ("radio1"). wext_ioctl() resolves that for ioctls
+ * (patch 204), /proc paths need the same. Returns a static buffer.
+ */
+static const char * wext_rtl_ifname(const char *name)
+{
+	static char ifname[IFNAMSIZ];
+	const char *resolved = wext_uci_ifname(name);
+
+	snprintf(ifname, sizeof(ifname), "%s", resolved ? resolved : name);
+
+	return ifname;
+}
+
+/*
+ * RX23302: read "key: value" from a text file the rtl8192cd driver publishes in
+ * /proc/<ifname>/ (mib_11n, mib_operation, mib_rf). The driver prints every key
+ * on its own line with leading spaces: "    currBW: 80M". The first match wins.
+ *
+ * Returns 0 and the trimmed value in buf, or -1 when the file or the key is
+ * missing. The key is matched whole: "currBW" does not match "currBW(op)".
+ */
+static int wext_rtl_proc_value(const char *ifname, const char *file,
+                               const char *key, char *buf, size_t len)
+{
+	FILE *f;
+	char path[64], line[256];
+	size_t klen = strlen(key);
+	int rv = -1;
+
+	snprintf(path, sizeof(path), "/proc/%s/%s", wext_rtl_ifname(ifname), file);
+
+	if (!(f = fopen(path, "r")))
+		return -1;
+
+	while (fgets(line, sizeof(line), f))
+	{
+		char *p = line, *e;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+
+		if (strncmp(p, key, klen) || p[klen] != ':')
+			continue;
+
+		p += klen + 1;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+
+		e = p + strlen(p);
+
+		while (e > p && (e[-1] == '\n' || e[-1] == '\r' || e[-1] == ' ' || e[-1] == '\t'))
+			*--e = 0;
+
+		snprintf(buf, len, "%s", p);
+		rv = 0;
+		break;
+	}
+
+	fclose(f);
+
+	return rv;
+}
+
+/*
+ * RX23302: frequency band of a channel by its centre frequency, the same ranges
+ * as nl80211_freq2band() of the nl80211 backend.
+ */
+static uint8_t wext_rtl_freq2band(int mhz)
+{
+	if (mhz >= 5160 && mhz <= 5885)
+		return IWINFO_BAND_5;
+	else if (mhz >= 5925 && mhz <= 7125)
+		return IWINFO_BAND_6;
+	else if (mhz >= 58320 && mhz <= 69120)
+		return IWINFO_BAND_60;
+
+	return IWINFO_BAND_24;
+}
+
+/*
+ * RX23302: operating channel width of the interface in MHz, from
+ * /proc/<ifname>/mib_11n: "currBW(op): 80M" (CurrentChannelBW, what the radio
+ * runs right now) or, failing that, "currBW: 20M" (the configured width).
+ */
+static int wext_rtl_bw_mhz(const char *ifname)
+{
+	char val[32];
+
+	if (wext_rtl_proc_value(ifname, "mib_11n", "currBW(op)", val, sizeof(val)) &&
+	    wext_rtl_proc_value(ifname, "mib_11n", "currBW", val, sizeof(val)))
+		return -1;
+
+	return atoi(val);
+}
+
+/*
+ * RX23302: true when ifname belongs to the rtl8192cd driver (it publishes
+ * /proc/<ifname>/sta_info, other wext drivers do not).
+ */
+static int wext_rtl_is_rtl(const char *ifname)
+{
+	char path[64];
+
+	snprintf(path, sizeof(path), "/proc/%s/sta_info", wext_rtl_ifname(ifname));
+
+	return access(path, R_OK) == 0;
+}
+
+/*
+ * RX23302: signal of an access point = average signal of its associated
+ * stations, the way the nl80211 backend reports it (nl80211_fill_signal walks
+ * the station dump). The driver has no SIOCGIWSTATS handler (see patch 203);
+ * the RSSI of every station is in /proc/<ifname>/sta_info as dBm + 100
+ * (patch 200).
+ */
+static int wext_rtl_avg_signal(const char *ifname, int *buf)
+{
+	FILE *f;
+	char path[64], line[256];
+	int sum = 0, n = 0;
+
+	snprintf(path, sizeof(path), "/proc/%s/sta_info", wext_rtl_ifname(ifname));
+
+	if (!(f = fopen(path, "r")))
+		return -1;
+
+	while (fgets(line, sizeof(line), f))
+	{
+		char *p = line;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+
+		if (!strncmp(p, "rssi:", 5))
+		{
+			int rssi = atoi(p + 5);
+
+			if (rssi > 0 && rssi <= 100)
+			{
+				sum += rssi - 100;
+				n++;
+			}
+		}
+	}
+
+	fclose(f);
+
+	if (!n)
+		return -1;
+
+	*buf = sum / n;
+	return 0;
+}
+
+/*
+ * RX23302: the driver's private get_mib ioctl, as "iwpriv <if> get_mib <name>"
+ * of the vendor tools: SIOCDEVPRIVATE + 2, the MIB name goes in, the raw value
+ * comes back in the same buffer (8192cd_ioctl.c, RTL8192CD_IOCTL_GET_MIB).
+ * Strings come back NUL-terminated, at most as long as the MIB field.
+ */
+#ifndef SIOCDEVPRIVATE
+#define SIOCDEVPRIVATE	0x89F0
+#endif
+#define RTL8192CD_IOCTL_GET_MIB	(SIOCDEVPRIVATE + 0x2)
+
+static int wext_rtl_get_mib(const char *ifname, const char *name, char *buf, size_t len)
+{
+	struct iwreq wrq;
+	char data[64];
+
+	memset(&wrq, 0, sizeof(wrq));
+	memset(data, 0, sizeof(data));
+	snprintf(data, sizeof(data), "%s", name);
+
+	wrq.u.data.pointer = (caddr_t) data;
+	wrq.u.data.length  = strlen(data) + 1;
+
+	if (wext_ioctl(ifname, RTL8192CD_IOCTL_GET_MIB, &wrq) < 0)
+		return -1;
+
+	memcpy(buf, data, (len < sizeof(data)) ? len : sizeof(data));
+	return 0;
+}
+
+/*
+ * RX23302: chip model, from /proc/<ifname>/mib_rf "chipVersion: RTL8197G Test"
+ * or "RTL8812F MP". The second word is the vendor's cut tag, not a model.
+ */
+static int wext_rtl_chip(const char *ifname, char *buf, size_t len)
+{
+	char val[64], *sp;
+
+	if (wext_rtl_proc_value(ifname, "mib_rf", "chipVersion", val, sizeof(val)) ||
+	    strncmp(val, "RTL", 3))
+		return -1;
+
+	if ((sp = strchr(val, ' ')) != NULL)
+		*sp = 0;
+
+	snprintf(buf, len, "%s", val);
+	return 0;
+}
+
