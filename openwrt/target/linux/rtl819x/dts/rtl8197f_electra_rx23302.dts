// SPDX-License-Identifier: GPL-2.0
/*
 * ELECTRA-RX23302 (Ростелеком) — Realtek RTL8197FH-VG
 *
 * Всё, что ниже, снято с живого устройства 2026-08-11:
 *   /proc/mtd, /proc/cpuinfo, /proc/iomem, /proc/interrupts,
 *   полный boot-log с холодного старта (bootcode v3.4T-pre4.6).
 *
 *   SoC     RTL8197FH-VG, MIPS 24Kc @ 999 MHz
 *   DRAM    DDR2 533 MHz, 64 МБ  ("Detect dram size = 64MB (0x04000000)")
 *   Flash   XM25QH128C (XMC), 16 МБ, erase 4K, ядро гоняет SPI на 41 MHz
 *   Switch  RTL8367RB (маркировка на чипе), гигабит подтверждён линком 1 Gbps
 *   WiFi    2.4G встроенный в SoC; 5G RTL8812FE по PCIe 10ec:f812
 *   UART    ttyS0 @ 0x18147000, 38400 8N1
 *
 * За основу взят Device/GWR1200AC — у него совпадают адрес загрузки
 * 0x80A00000 (в нашем логе "Jump to image start=0x80a00000"),
 * адрес ядра 0x30000 и консоль 38400.
 */

/dts-v1/;

#include "RTL8197FVG.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "electra,rx23302", "realtek,rtl8197f-soc";
	model = "ELECTRA RX23302";

	memory {
		device_type = "memory";
		reg = <0x0 0x4000000>;
	};

	chosen {
		bootargs = "console=ttyS0,38400";
	};
};

/*
 * Светодиод Status — линия H1 (gpio1 бит 25), активный низкий.
 * Найден на стоке (структура gpio_led: wifi2.4=33, wifi5=100, status=57,
 * trigger=timer) и проверен руками 29.10.2026: 0 на линии = горит.
 * 2.4G LED там же ждёт своего часа (пин E1 не отдаётся без pinmux).
 */
/ {
	leds {
		compatible = "gpio-leds";
		status = "okay";

		status_led: status {
			label = "green:status";
			gpios = <&gpio1 25 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

/*
 * Кнопка Reset - линия 54 (порт G пин 6, gpio1 бит 22), нажата = 0.
 * Reset button - line 54 (port G pin 6, gpio1 bit 22), active low.
 *
 * Проверено на железе 21.10.2026: при нажатии меняется только этот бит
 * (0xB8003528, 05C00001 -> 05800001). Тот же вывод читает загрузчик:
 * Reset, зажатый при включении питания, открывает аварийный TFTP
 * (192.168.1.6), см. docs/install-tftp.md.
 * Verified on hardware: only this bit changes when pressed. The
 * bootloader reads the same pin: hold Reset at power-on to get its
 * TFTP recovery (192.168.1.6), see docs/install-tftp.md.
 *
 * Опрос, а не прерывание: прерывания этого GPIO-контроллера не проверены.
 * Polled, not interrupt-driven: GPIO IRQs of this controller are untested.
 */
/ {
	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		reset {
			label = "reset";
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};
};

&ethernet {
	status = "okay";

	/*
	 * MAC берётся из флеша: nvmem-ячейка "mac-address" указывает на
	 * заводскую запись в hwconfig (boot, 0x20007, 6 байт) - у каждой
	 * коробки своя, прошивкой не затирается. Realtek шьёт её с первым
	 * байтом 00, но заводской ставить в eth0 нельзя: во внутреннем
	 * свитче на него осталась статическая запись, привязанная к другому
	 * порту, - с ним умирает передача. Драйвер поднимает признак
	 * местного назначения: 00 -> 02. Нет записи во флеше - MAC из
	 * device tree, нет и там - случайный при каждой загрузке (профили
	 * "Сеть 3", "Сеть 6" и дальше в Windows).
	 */
	nvmem-cells = <&mac_factory>;
	nvmem-cell-names = "mac-address";
};


/*
 * Внешний коммутатор RTL8367D (номер 0x6642, версия 0x0030).
 * External RTL8367D switch (chip number 0x6642, version 0x0030).
 *
 * Драйвер - rtl8367b из OpenWrt (GPL, swconfig) с поддержкой этой
 * версии чипа; шина SMI на GPIO (порт H пин 0 = SCK, порт G пин 7 =
 * SDA), сброс - порт H пин 2. Номер линии в gpio1 = порт * 8 + пин - 32.
 *
 * Гнёзда: синий WAN = порт 0, LAN1 = порт 3, LAN2 = порт 4,
 * процессор = порт 7 (RGMII, внешний интерфейс 1). Порты 1, 2, 5, 6
 * не разведены.
 *
 * realtek,init-regs - настройка платы, которую драйвер пишет сразу
 * после таблицы самого чипа: значения, снятые с работающего
 * загрузчика, подъём RGMII порта 7 (0x12c7/0x12cf принудительная
 * связь 1000/полный, 0x1d70 MAC7 на EXT1, третья часть идёт подряд,
 * без пауз - иначе связь не поднимается) и CPU-тег на приём
 * (0x121a = 0x0239, 4 байта, ловушка - порт 7). Порядок важен.
 * Те же записи и в том же порядке делала прошивка v6.7 (149 штук,
 * повторы оставлены как были).
 *
 * Исключение - 0x1b03 (LED_CONFIGURATION, общий для всех портов):
 * у загрузчика 0x0936, с ним лампы WAN/LAN не горят. 0x0222 - линк и
 * мигание при передаче; проверено глазами на WAN, LAN1, LAN2 21.10.2026.
 * Каким портам выведены лампы - 0x1b24/0x1b25 (маска 0x1f = порты 0-4).
 * Exception: 0x1b03 (LED mode, all ports) is 0x0222 = link/activity;
 * the bootloader value 0x0936 leaves the port LEDs dark.
 */
/ {
	switch0: switch {
		compatible = "realtek,rtl8367b";
		sck-gpios = <&gpio1 24 GPIO_ACTIVE_HIGH>;	/* линия 56, H0 */
		sda-gpios = <&gpio1 23 GPIO_ACTIVE_HIGH>;	/* линия 55, G7 */
		reset-gpios = <&gpio1 26 GPIO_ACTIVE_LOW>;	/* линия 58, H2 */
		realtek,cpu-port = <7>;
		realtek,init-regs = <
			0x1b24 0x001f 0x1b24 0x1f1f 0x03f7 0x0000 0x1305 0xc010
			0x1311 0x1076 0x1307 0x0002 0x121a 0x0001 0x1219 0x0040
			0x121a 0x0031 0x121a 0x0035 0x0890 0x00ff 0x0891 0x00ff
			0x0892 0x00ff 0x0073 0x0060 0x0243 0x0086 0x0500 0x0000
			0x0501 0x0000 0x0510 0x0000 0x0890 0x009f 0x0891 0x009f
			0x0892 0x009f 0x0893 0x009f 0x0894 0x009f 0x0895 0x009f
			0x0896 0x009f 0x0897 0x009f 0x0898 0x009f 0x0899 0x009f
			0x089a 0x009f 0x089b 0x009f 0x089c 0x009f 0x089d 0x009f
			0x089e 0x009f 0x089f 0x009f 0x08a0 0x009f 0x08a1 0x009f
			0x08a2 0x008f 0x08a3 0x008f 0x08a4 0x008f 0x08a5 0x008f
			0x08a6 0x0090 0x0a26 0x0840 0x0a32 0x0bb8 0x0a33 0x0bb8
			0x0a34 0x0bb8 0x0a35 0x0bb8 0x1106 0x0000 0x1118 0x0000
			0x1119 0x000b 0x1124 0x0088 0x1219 0x0080 0x121a 0x00bd
			0x121b 0x00bd 0x12c1 0x0000 0x12cf 0xffff 0x12d7 0x0076
			0x12d8 0x0076 0x12d9 0x0076 0x12da 0x0076 0x12db 0x0076
			0x12dc 0x0076 0x12dd 0x0076 0x12de 0x0076 0x12df 0x0076
			0x12e0 0x0076 0x12e1 0x0076 0x12e2 0x0076 0x12e3 0x0076
			0x12e4 0x0076 0x12e5 0x0076 0x12e6 0x0076 0x1300 0x0000
			0x1303 0x07d6 0x1304 0x7544 0x1305 0x0010 0x1307 0x0002
			0x130c 0x0053 0x1336 0x0050 0x1337 0x0050 0x1338 0x0050
			0x1339 0x0050 0x133a 0x0050 0x133b 0x0050 0x133c 0x0050
			0x133f 0x001f 0x1344 0x0200 0x1345 0x0200 0x1346 0x0200
			0x1347 0x0200 0x1348 0x0200 0x13c2 0x0000 0x13e0 0x0000
			0x13e2 0x0120 0x1d1a 0x0100 0x1d52 0x2411 0x1d53 0x8000
			0x1d54 0x0008 0x1d58 0x0000 0x1d59 0x2411 0x1d5a 0x8000
			0x1d5b 0x0008 0x1d63 0x03f0 0x1f00 0x0000 0x1f02 0x0000
			0x03f7 0x0000 0x1305 0x0011 0x1310 0x1076 0x03f7 0x0000
			0x1305 0x0011 0x1311 0x1076 0x03f7 0x0000 0x13c3 0x0001
			0x13c4 0x1076 0x08a2 0x00ff 0x08a3 0x00ff 0x08a4 0x00ff
			0x08a5 0x00ff 0x08a6 0x00ff 0x08a7 0x00ff 0x08a8 0x00ff
			0x08a9 0x00ff 0x08a2 0x008f 0x08a6 0x0090 0x0918 0x0000
			0x091d 0x0000 0x1119 0x000b 0x1200 0x1fc6 0x121e 0x0794
			0x12d7 0x0076 0x12f6 0x2e2c 0x1b03 0x0222 0x1d1a 0x0100
			0x1d1b 0xdd60 0x1d70 0x2000 0x1dad 0x97f3 0x1233 0x06a4
			0x1234 0x00c8 0x1237 0x0140 0x1238 0x00f0 0x1239 0x0108
			0x123a 0x0060 0x12af 0x0000 0x12c7 0x0076 0x08a2 0x00ff
			0x08a3 0x00ff 0x08a4 0x00ff 0x08a5 0x00ff 0x08a6 0x00ff
			0x121a 0x0239
		>;
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		/*
		 * 15 МГц, как у стока. Не 41: наш драйвер шины считает делитель
		 * как ceil(105МГц / частота), при 41 выходит делитель 3, то есть
		 * 35 МГц, и чтение с флеша возвращает мусор — ядро не находит
		 * squashfs там, где загрузчик его прекрасно читает. Сток в своём
		 * логе печатает "change speed to 15000000Hz, div 7" и больше
		 * скорость не меняет.
		 */
		spi-max-frequency = <15000000>;

		/*
		 * Флеш 16 МБ, два набора по 8 МБ.
		 *
		 * Набор 1 (0x000000..0x800000) — рабочий, сюда ставим OpenWrt.
		 * Иначе нельзя, и это проверено: загрузчик ищет ядро только внизу
		 * флеша (перебор 0x10000..0x2F0000) и на 0x830000 не смотрит никогда,
		 * а стоковая утилита двойной загрузки затирает набор 2 копией
		 * набора 1 — она сама пишет об этом при загрузке:
		 *   "dual boot utility: image already copied to backup bank"
		 *
		 * Набор 2 (0x800000..0x1000000) — заводская копия, только чтение.
		 * Это путь отката, причём без компьютера: у загрузчика есть чтение
		 * FLR, запись FLW и сравнение CMP, то есть восстановление это
		 * "прочитать 0x830000 в память, записать на 0x30000".
		 *
		 * Смещения подтверждены трижды: /proc/mtd стока, вывод его же
		 * утилиты двойной загрузки и прямое чтение флеша командой FLR:
		 *   linux_offset=0x30000,      rootfs_offset=0x300000
		 *   back_linux_offset=0x830000, back_rootfs_offset=0xB00000
		 *
		 * 0x0..0x30000 трогать нельзя никогда: там bootcode (0x0..0x20000)
		 * и hwconfig (0x20000..0x30000) с MAC-адресами, калибровкой радио
		 * и заводскими настройками — теми самыми, что возвращает кнопка
		 * сброса через драйвер "Realtek GPIO Driver for Flash Reload Default".
		 */

		/*
		 * Обёртка partitions обязательна: без неё ядро не считает
		 * разделы описанными в device tree, делает их своими, и у
		 * nvmem-устройств нет узла DT - ячейку "mac-address" тогда
		 * не от кого читать (of_nvmem_cell_get: ENOENT).
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x000000 0x030000>;
				read-only;

				#address-cells = <1>;
				#size-cells = <1>;

				/*
				 * Заводская таблица MAC (hwconfig): заголовок "H601" на
				 * 0x20000, дальше десять записей по 6 байт (eth, радио).
				 * Первая - системная, у каждой коробки своя, прошивкой
				 * не затирается. Снято со сток-дампа 20.10.2026.
				 *
				 * Канон 6.18: ячейка живёт в nvmem-layout - иначе её не
				 * от кого читать, у mtd-nvmem нет своего узла DT.
				 */
				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					mac_factory: macaddr@20007 {
						compatible = "mac-base";
						reg = <0x20007 0x6>;
					};
				};
			};

			partition@30000 {
				label = "kernel";
				reg = <0x030000 0x2d0000>;
			};

			/*
			 * Корневая система занимает ровно свой раздел и ни байтом больше.
			 *
			 * Хвост под настройки выкраивать из неё НЕЛЬЗЯ, хотя OpenWrt умеет
			 * это сама: она кладёт его сразу за телом squashfs, а ровно там
			 * загрузчик держит два байта своей контрольной суммы. Проверено
			 * дорогой ценой — команда стирания этого хвоста снесла сумму, и на
			 * следующей загрузке загрузчик посчитал набор негодным и затёр нашу
			 * прошивку заводской копией из второго банка.
			 *
			 * Поэтому CONFIG_MTD_SPLIT_SQUASHFS_ROOT выключен, а место под
			 * настройки объявлено отдельным разделом ниже.
			 *
			 * 3 МБ: тело нашего образа 0x233002, запас около 850 КБ.
			 */
			partition@300000 {
				label = "rootfs";
				reg = <0x300000 0x300000>;
			};

			/* Настройки: до контрольной суммы отсюда не дотянуться. */
			partition@600000 {
				label = "rootfs_data";
				reg = <0x600000 0x1a0000>;
			};

			partition@7a0000 {
				label = "cfg";
				reg = <0x7a0000 0x060000>;
				read-only;
			};

			partition@800000 {
				label = "stock";
				reg = <0x800000 0x800000>;
				read-only;
			};
		};
	};
};

/*
 * ─────────────────────────────────────────────────────────────────
 * ЕЩЁ НЕ ОПИСАНО — нет достоверных данных:
 *
 * 1. Ethernet + свитч RTL8367RB.
 *    Свитч сконфигурирован стоком на 5 интерфейсов, физически на корпусе
 *    3 разъёма (1 WAN + 2 LAN). Из boot-лога:
 *      eth1 (port mask 0x01, VLAN 1) = WAN
 *      LAN — два из {eth3:0x02, eth4:0x04, eth0:0x08, eth2:0x10}
 *    Какие именно распаяны — определяется поочерёдным втыканием кабеля.
 *    В mainline есть DSA-драйвер rtl8365mb (compatible "realtek,rtl8365mb"),
 *    в его bindings RTL8367RB-VB присутствует.
 *
 * 2. Светодиоды. В /bin/led_test.sh стока: LAN_LEDS="54 55 56 57",
 *    58 (статус), 11 (USB). Этот скрипт НЕ про нашу плату: 54 - кнопка
 *    Reset (проверено нажатием 21.10.2026, узел keys выше), 55/56 - SMI
 *    свитча, 58 - его сброс. Где светодиоды на самом деле - не проверено.
 *
 * 3. WiFi-узлы — появятся, когда заведём rtl8192cd с halmac_8197f.
 * ─────────────────────────────────────────────────────────────────
 */

/*
 * ─────────────────────────────────────────────────────────────────
 * Шина PCIe, 30.08.2026.
 *
 * Драйвер вайфая rtl8192cd регистрируется как PCI-устройство
 * (pci_register_driver в 8192cd_osdep.c:14218), поэтому без шины он
 * не увидит ни встроенную радиочасть, ни карту 5 ГГц.
 *
 * Узел контроллера описан в RTL819X.dtsi и стоял выключенным. Драйвер
 * контроллера у нас есть: arch/mips/pci/pci-realtek.c, 469 строк,
 * подключён заплатой 0005 по CONFIG_REALTEK, совпадение по строке
 * "realtek,rtl8196b-pci".
 *
 * Второй контроллер (pcie1) пока не трогаем: сперва посмотрим, что
 * даст первый.
 * ─────────────────────────────────────────────────────────────────
 */
/*
 * Узел оставлен ВЫКЛЮЧЕННЫМ: встроенная радиочасть подключается
 * прямым адресом (TYPE_EMBEDDED), шина PCI ей не нужна, а её включение
 * подвешивало загрузку. Понадобится только для карты 5 ГГц.
 */
/* &pcie0 { status = "okay"; }; */
