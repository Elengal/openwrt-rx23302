CONFIG_RTL8366_SMI_DEBUG_FS=y
# Радиочасть временно выключена: драйвер доходит до rtl8192cd_init_one
# и виснет, а встроенным он собирается только как bool, то есть вешает
# всю загрузку. Пока цель — рабочая проводная прошивка в постоянной
# памяти. Сборочный файл вендора строит единый rtl8192cd.o, так что
# позже его можно перевести в tristate и грузить модулем вручную.
CONFIG_WLAN_HAL=y
CONFIG_WLAN_HAL_88XX=y
# CONFIG_WLAN_MACHAL_API is not set
CONFIG_WLAN_HAL_8197F=y
CONFIG_RTL_ODM_WLAN_DRIVER=y
CONFIG_PCI_HCI=y
# CONFIG_PCI is not set
# CONFIG_PCI_QUIRKS is not set
CONFIG_RTL8192FE_RX23302=y
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_CORE=y
CONFIG_WEXT_PRIV=y
CONFIG_WEXT_PROC=y
