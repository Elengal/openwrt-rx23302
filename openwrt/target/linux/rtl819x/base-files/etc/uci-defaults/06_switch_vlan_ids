#
# RX23302: switch VLAN IDs 1/2 (as generated by ucidef_add_switch) -> 9/8.
#
# The SoC's internal switch (RTL8197F, configured by rtl819x_eth.c) forwards
# only VLAN 9 (LAN) and VLAN 8 (WAN) between its port 0 (RGMII to the
# RTL8367D) and the CPU; frames tagged 1 or 2 would be dropped there.
# 9 and 8 are also the stock firmware's numbers. WAN gets FID 1 so MAC
# addresses learned on WAN and LAN never mix.
#
# Runs once, and only on the untouched generated config: switch_vlan 1 with
# lan on eth0.1 and switch_vlan 2 with wan on eth0.2.

. /lib/functions.sh

[ "$(board_name)" = "electra,rx23302" ] || exit 0

renumber() {
	local sec="$1" vlan
	config_get vlan "$sec" vlan
	case "$vlan" in
		1) uci set network."$sec".vlan='9' ;;
		2) uci set network."$sec".vlan='8'
		   # own address-learning table for WAN, as before (FID 1)
		   uci set network."$sec".fid='1' ;;
	esac
}

[ "$(uci -q get network.lan.device)" = "br-lan" ] || exit 0
[ "$(uci -q get network.wan.device)" = "eth0.2" ] || exit 0

config_load network
config_foreach renumber switch_vlan

for sec in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)=device$/\1/p"); do
	[ "$(uci -q get network."$sec".name)" = "br-lan" ] || continue
	uci -q del_list network."$sec".ports='eth0.1'
	uci -q add_list network."$sec".ports='eth0.9'
done
uci set network.wan.device='eth0.8'
[ -n "$(uci -q get network.wan6)" ] && uci set network.wan6.device='eth0.8'
uci commit network

exit 0
