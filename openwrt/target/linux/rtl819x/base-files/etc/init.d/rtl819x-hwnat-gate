#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# RX23302, часть 2 из 2: гейты аппаратного NAT (router mode + hwnat + каркас
# ASIC) по галке LuCI «Flow offloading: Hardware».
#
# Запускается ПОСЛЕ сети (95 > 20): router mode пишет в свитч PVID/VLAN/
# MACCR1, а драйвер при ifup перезаписывает их в rtl819x_intsw_nastroit().
# Включение до ifup давало кривой L2 (проверено 29.10: сеть пропадала).
#
# hw=1: router mode ON, гейт hwnat=1, `cat /proc/rtl865x_gw` (каркас).
# hw=0: гейт и router mode OFF (свитч в обычном режиме — софт-путь).

START=95
USE_PROCD=1

log() { logger -t rtl819x-hwnat-gate "$@"; }

# Роутер это или точка доступа (dumb AP/мост)? В AP-режиме нет отдельного
# WAN-интерфейса: он удалён/выключен, либо WAN — сам br-lan. Аппаратный NAT
# там не применим (нет маршрутизации — трафик L2), а router mode перестроил
# бы свитч и мог отрезать WAN-гнездо от моста (эксперимент 29.10: сеть
# через LAN1 жила, а WAN-порт выпадал в VLAN 8). Поэтому в AP не включаем.
is_router() {
	local dev
	[ "$(uci -q get network.wan)" ] || return 1
	[ "$(uci -q get network.wan.disabled)" = "1" ] && return 1
	dev=$(uci -q get network.wan.device)
	[ -n "$dev" ] || return 1
	[ "$dev" = "br-lan" ] && return 1
	return 0
}

apply() {
	if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ] && ! is_router; then
		# AP-режим: честно выключаем гейты, оставляем мост как есть
		[ -w /sys/module/rtl819x/parameters/hwnat ] && \
			echo 0 > /sys/module/rtl819x/parameters/hwnat
		[ -w /proc/rtl819x_router ] && echo 0 > /proc/rtl819x_router
		log "AP-режим (нет отдельного WAN): аппаратный NAT не применим, гейты выкл"
	elif [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ]; then
		[ -w /proc/rtl819x_router ] && echo 1 > /proc/rtl819x_router
		[ -w /sys/module/rtl819x/parameters/hwnat ] && \
			echo 1 > /sys/module/rtl819x/parameters/hwnat
		cat /proc/rtl865x_gw >/dev/null 2>&1
		log "аппаратный NAT ВКЛ (router mode + hwnat, каркас запрограммирован)"
	else
		[ -w /sys/module/rtl819x/parameters/hwnat ] && \
			echo 0 > /sys/module/rtl819x/parameters/hwnat
		[ -w /proc/rtl819x_router ] && echo 0 > /proc/rtl819x_router
		log "аппаратный NAT выкл (router mode 0, софт-путь)"
	fi
}

start_service() { apply; }
stop_service() {
	[ -w /sys/module/rtl819x/parameters/hwnat ] && \
		echo 0 > /sys/module/rtl819x/parameters/hwnat
	[ -w /proc/rtl819x_router ] && echo 0 > /proc/rtl819x_router
}

# Переключение галки на ЖИВОМ роутере: router mode на лету нестабилен —
# 29.10 (img-toggle) живое включение один раз сработало, другой раз
# уронило RX (VLAN 9 без порта 0 / CPU-tag) и повесило box намертво
# (большой кадр = wedge; лечится только питанием). Поэтому смену режима
# применяем перезагрузкой: сниппет уже подготовлен сервисом rtl819x-hwnat
# (START=17), гейты поднимутся на старте этого сервиса (START=95).
reload_service() {
	local want=0 cur=0
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "1" ] && \
		is_router && want=1
	[ "$(head -1 /proc/rtl819x_router 2>/dev/null)" = "1" ] && cur=1

	if [ "$want" = "$cur" ]; then
		# режим не меняется (правка firewall ради других правил) —
		# ничего не трогаем
		return 0
	fi
	log "смена режима NAT ($cur -> $want): перезагрузка (гейты на лету нестабильны)"
	reboot
}

service_triggers() {
	procd_add_reload_trigger firewall
}
